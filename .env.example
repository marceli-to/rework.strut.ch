APP_NAME="Strut Architekten"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://strut.ch.test
APP_META_DESCRIPTION="Strut Architekten Winterthur"

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=rework_strut
DB_USERNAME=
DB_PASSWORD=

# Read-only connection to the legacy strut.ch database (used by strut:import / strut:verify)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_SOCKET=
LEGACY_DB_DATABASE=strut.ch
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
# Absolute path to the legacy storage/app/public/media folder (source of media files, never modified)
LEGACY_MEDIA_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="mail@strut.ch"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_MAPS_KEY=

VITE_APP_NAME="${APP_NAME}"
